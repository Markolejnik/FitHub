<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".WorkoutViewerFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/goBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/goback"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/wViewerTitle"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_marginEnd="50dp"
            android:ellipsize="end"
            android:fontFamily="@font/oswald_semibold"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Workout Title"
            android:textColor="@color/colorAccent"
            android:textSize="30sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/goBack"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/exit"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_exit_foreground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foregroundGravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wViewerGroups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/oswald_semibold"
            android:gravity="center"
            android:text="No muscle groups used."
            android:textColor="@color/linecolor"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/exerciseTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/oswald_semibold"
        android:foregroundGravity="center"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="Exercise Title"
        android:textColor="@color/foreground"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/goBack"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/imageLayout"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_weight="0">

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/benchpress1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/setInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="44dp"
            android:fontFamily="@font/oswald_semibold"
            android:foregroundGravity="center"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:shadowColor="#000000"
            android:shadowDx="8"
            android:shadowDy="10"
            android:shadowRadius="5"
            android:text="0 Sets of 0 Reps"
            android:textAlignment="viewEnd"
            android:textColor="@color/foreground"
            android:textSize="30sp"
            app:layout_constraintBottom_toBottomOf="@+id/image"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/setCounterTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/oswald_semibold"
            android:foregroundGravity="center"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Sets Done"
            android:textColor="@color/foreground"
            android:textSize="40sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/setCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="33dp"
            android:fontFamily="@font/oswald_semibold"
            android:foregroundGravity="center"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="0"
            android:textColor="@color/foreground"
            android:textSize="50sp"
            app:layout_constraintBottom_toTopOf="@+id/setCounterButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/setCounterTitle" />

        <Button
            android:id="@+id/setCounterButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/round_filter"
            android:fontFamily="@font/oswald_semibold"
            android:paddingLeft="40dp"
            android:paddingTop="10dp"
            android:paddingRight="40dp"
            android:paddingBottom="10dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="5"
            android:shadowRadius="5"
            android:text="Add Set"
            android:textColor="@color/foreground"
            android:textSize="30sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/prevExercise"
            android:layout_width="70dp"
            android:layout_height="120dp"
            android:layout_marginBottom="30dp"
            android:elevation="10dp"
            android:rotation="180"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_arrow_foreground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/prevExerciseText"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            android:fontFamily="@font/oswald_semibold"
            android:foregroundGravity="center"
            android:gravity="center"
            android:text="Previous Exercise"
            android:textColor="@color/foreground"
            android:textSize="12dp"
            app:layout_constraintEnd_toEndOf="@+id/prevExercise"
            app:layout_constraintStart_toStartOf="@+id/prevExercise"
            app:layout_constraintTop_toBottomOf="@+id/prevExercise" />

        <ImageView
            android:id="@+id/nextExercise"
            android:layout_width="70dp"
            android:layout_height="120dp"
            android:layout_marginBottom="30dp"
            android:elevation="10dp"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_arrow_foreground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/nextExerciseText"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"
            android:fontFamily="@font/oswald_semibold"
            android:foregroundGravity="center"
            android:gravity="center"
            android:text="Next Exercise"
            android:textColor="@color/foreground"
            android:textSize="12dp"
            app:layout_constraintEnd_toEndOf="@+id/nextExercise"
            app:layout_constraintStart_toStartOf="@+id/nextExercise"
            app:layout_constraintTop_toBottomOf="@+id/nextExercise" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>