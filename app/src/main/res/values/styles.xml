<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomCalendarViewStyle">
        <!-- Customize other attributes as needed -->

        <!-- Style for selected date -->
        <item name="android:selectedDateVerticalBar">@color/colorAccent</item>
        <item name="android:dateTextAppearance">@style/CustomDateTextAppearance</item>
        <!-- Style for the current day -->
        <item name="android:weekDayTextAppearance">@style/CustomWeekDayTextAppearance</item>
        <item name="android:datePickerDialogTheme">@style/CustomDatePickerDialogTheme</item>
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="android:textColorPrimaryInverse">@color/foreground</item>
    </style>

    <!-- Custom style for date text -->
    <style name="CustomDateTextAppearance" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textSize">16sp</item> <!-- Customize text size -->
    </style>

    <!-- Custom style for current day text -->
    <style name="CustomWeekDayTextAppearance" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:textSize">18sp</item> <!-- Customize text size -->
    </style>

    <style name="CustomDatePickerDialogTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Customize the selected day indicator color -->
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <style name="MenuTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Customize the selected day indicator color -->
        <item name="android:fontFamily">@font/oswald_semibold</item>
    </style>

    <style name="LaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/splashscreen</item>
    </style>
</resources>