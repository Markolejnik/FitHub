<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">


    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginStart="8dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@drawable/alternatingdumbbellpress1" />


    <TextView
        android:id="@+id/exercise"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/oswald_semibold"
        android:maxLines="1"
        android:text="TextView"
        android:textColor="@color/foreground"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@+id/thumbnail"
        app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/round_filter"
            android:backgroundTint="#FE5700"
            android:paddingHorizontal="7dp"
            android:paddingTop="1dp"
            android:paddingBottom="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.985"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/exercise">

            <TextView
                android:id="@+id/sets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/oswald_semibold"
                android:padding="2dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="3"
                android:shadowRadius="3"
                android:text="Sets"
                android:textColor="@color/foreground"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@+id/repsOrSec"
                app:layout_constraintEnd_toStartOf="@+id/textView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/repsOrSec" />

            <TextView
                android:id="@+id/reps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/oswald_semibold"
                android:padding="2dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="3"
                android:shadowRadius="3"
                android:text="Reps"
                android:textColor="@color/foreground"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@+id/repsOrSec"
                app:layout_constraintEnd_toStartOf="@+id/repsOrSec"
                app:layout_constraintTop_toTopOf="@+id/repsOrSec"
                app:layout_constraintVertical_bias="1.0" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/oswald_semibold"
                android:padding="2dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="3"
                android:shadowRadius="3"
                android:text="x"
                android:textColor="@color/foreground"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@+id/repsOrSec"
                app:layout_constraintEnd_toStartOf="@+id/reps"
                app:layout_constraintTop_toTopOf="@+id/repsOrSec" />

            <TextView
                android:id="@+id/repsOrSec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:fontFamily="@font/oswald_semibold"
                android:padding="2dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="3"
                android:shadowRadius="3"
                android:text="Reps"
                android:textColor="@color/foreground"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@+id/sets"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>