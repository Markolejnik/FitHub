<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/constraintLayout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">


    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/exercise"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/oswald_semibold"
        android:maxLines="1"
        android:text="TextView"
        android:textColor="@color/foreground"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/thumbnail"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.815" />

    <TextView
        android:id="@+id/sets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/oswald_semibold"
        android:text="Sets"
        android:textColor="@color/foreground"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/exercise" />

    <TextView
        android:id="@+id/reps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/oswald_semibold"
        android:text="Reps"
        android:textColor="@color/foreground"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/sets"
        app:layout_constraintEnd_toStartOf="@+id/repsOrSec"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/oswald_semibold"
        android:text="x"
        android:textColor="@color/foreground"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/sets"
        app:layout_constraintEnd_toStartOf="@+id/reps" />

    <TextView
        android:id="@+id/repsOrSec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:fontFamily="@font/oswald_semibold"
        android:text="Reps"
        android:textColor="@color/foreground"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/sets"
        app:layout_constraintEnd_toEndOf="parent" />

